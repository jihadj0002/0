# MatrixAI Environment Variables (copy to .env and fill in)
# See theMatrixAi/settings.py for all supported variables

SECRET_KEY=your-secret-key-here
ENCRYPT_KEY=your-encrypt-key-here
OPENROUTER_API_KEY=sk-or-v1-your-key

# Redis (required for task queue)
# Get this from Railway dashboard -> Redis plugin -> REDIS_URL
REDIS_URL=redis://default:password@host:port

# Database
DATABASE_URL=postgres://user:password@host:5432/dbname

# SMTP (optional — fallback to console in dev)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Your Name <your@email.com>

# Environment
ENVIRONMENT=development